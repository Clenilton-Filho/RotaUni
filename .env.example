# Configuracao de ambiente do RotaUni (Expo).
# Copie este arquivo para .env.local e ajuste os valores para o seu ambiente.
# O arquivo .env.local NAO deve ser versionado (veja .gitignore).
#
# Obs.: alterar variaveis EXPO_PUBLIC_* exige reiniciar o bundler
# (npx expo start) para que os novos valores sejam embutidos no bundle.

# URL base da API Spring Boot (RotaUni API).
# Moto G30 na rede local: use o IP da maquina rodando o backend (nao use localhost).
# Web/Emulador (API na mesma maquina): http://localhost:8080
EXPO_PUBLIC_API_BASE_URL=http://192.168.0.10:8080

# ----------------------------------------------------------------------------
# Fonte de dados MASTER (flag principal, recomendada):
#   Aplica-se a todos os modulos de uma vez.
#   mock -> todos os repositorios locais (dados de prototipo, AsyncStorage)
#   http -> todos os repositorios HTTP (backend Spring Boot)
# Nao informado: cai na MASTER (EXPO_PUBLIC_DATA_SOURCE).
# ----------------------------------------------------------------------------
EXPO_PUBLIC_DATA_SOURCE=mock

# Overrides por modulo (opcional; tem prioridade sobre a MASTER acima).
# Deixe os valores abaixo apenas se quiser chavear um modulo isoladamente;
# qualquer valor que nao seja 'http' cai em 'mock'.

# Fonte de dados das caronas:
#   mock -> MockRidesRepository (dados locais de src/data/rides.ts)
#   http -> HttpRidesRepository (GET {EXPO_PUBLIC_API_BASE_URL}/api/v1/rides)
# Nao informado: cai na MASTER.
EXPO_PUBLIC_RIDES_DATA_SOURCE=mock

# Fonte de dados de autenticacao e perfil (contas, login e /users/me):
#   mock -> repositorios locais (AsyncStorage; senhas com SHA-256 iterativo no device)
#   http -> HttpUserAccountRepository + HttpUserRepository
#           (POST /api/v1/auth/register, POST /api/v1/auth/login, GET /api/v1/users/me)
# Nao informado: cai na MASTER (EXPO_PUBLIC_DATA_SOURCE).
EXPO_PUBLIC_AUTH_DATA_SOURCE=mock

# Fonte de dados de reservas (POST /api/v1/bookings, GET /active, DELETE de cancelamento):
#   mock -> LocalBookingRepository (AsyncStorage; 1 reserva ativa por usuario no device)
#   http -> HttpBookingRepository (vagas e reserva ativa controladas pelo backend;
#           erros legiveis do servidor, ex. 400 carona lotada e 409 reserva duplicada)
# Nao informado: cai na MASTER (EXPO_PUBLIC_DATA_SOURCE).
EXPO_PUBLIC_BOOKING_DATA_SOURCE=mock

# Fonte de dados do historico de caronas (POST /bookings/{id}/finalize, GET /rides/history):
#   mock -> LocalRideHistoryRepository (AsyncStorage)
#   http -> HttpRideHistoryRepository (finalizacao e consulta no backend)
# Nao informado: cai na MASTER (EXPO_PUBLIC_DATA_SOURCE).
EXPO_PUBLIC_HISTORY_DATA_SOURCE=mock

# Fonte de dados de avaliacoes (POST /api/v1/ratings):
#   mock -> LocalRatingRepository (AsyncStorage)
#   http -> HttpRatingRepository (resolve historyId do backend automaticamente)
# Nao informado: cai na MASTER (EXPO_PUBLIC_DATA_SOURCE).
EXPO_PUBLIC_RATING_DATA_SOURCE=mock
